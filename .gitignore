.env
.env.local
.env.*.local
*.pem
*.key

# =============================================================================
# agnostic-ai generated outputs at the project root
#
# This repo dogfoods itself: source specs live under .agnostic-ai/ and are
# committed; the targets below are regenerated by `agnostic-ai sync` and
# stay out of git.
# =============================================================================
/.claude/
/.cursor/
/.gemini/
/.clinerules/
/.cline/
/.devin/
/.windsurf/
/.continue/
/.codex/
/.opencode/
/.junie/
/.kiro/
/.trae/
/.qoder/
/.factory/
/.kilo/
/kilo.jsonc
/crush.json
/.agents/
/.amp/
/.zed/
/.warp/
/.agent/
/.augment/
/.vscode/mcp.json
/CLAUDE.md
/CONVENTIONS.md
/.aider.conf.yml
/.github/copilot-instructions.md
/.github/instructions/
/.mcp.json
/opencode.json
# Codex / Amp / Warp share the open AGENTS.md standard and emit
# hierarchically; Gemini emits GEMINI.md hierarchically too.
**/AGENTS.md
**/GEMINI.md
AGENT.md
WARP.md
.rules
# Local sync state written by `agnostic-ai sync`.
.agnostic-ai/.sync-state
# Per-target audit fixtures need to ship their emitted tree intact so
# the kit-sink golden snapshot replays in CI.
!internal/adapters/*/testdata/**
# Per-target audit fixtures need to ship their emitted tree intact so
# the kit-sink golden snapshot replays in CI. The patterns above match
# adapter output names anywhere in the tree (e.g. **/AGENTS.md, .vscode/,
# .agent/, .rules), so re-allow every adapter's testdata/kitsink/ tree.
!internal/adapters/*/testdata/**
# Same re-allow for the integration-level golden fixtures: a target
# whose own emitted tree includes a nested AGENTS.md (Junie's preferred
# .junie/AGENTS.md entry-point mirror, target-audit 2026-08-01) or any
# other name the patterns above match needs its full tree committed too.
!tests/integration/fixtures/golden/**
# =============================================================================
# npm wrapper artifacts
#
# npm/bin/ ships only the JS shim; the Go binary next to it is downloaded at
# install time. `npm pack` drops a tarball in the package dir.
# =============================================================================
/npm/bin/agnostic-ai
/npm/node_modules/
/npm/*.tgz
/npm/package-lock.json

# =============================================================================
# Release scaffolding
# =============================================================================
# NOTES.md is built by .github/workflows/release.yml from CHANGELOG.md and
# fed to GoReleaser via --release-notes. GoReleaser refuses to release with
# a dirty tree, so the file must stay out of git.
/NOTES.md

# =============================================================================
# Tooling caches
# =============================================================================
/.golangci-cache/
/tmp/

# =============================================================================
# Playground build artifacts (rebuilt by `make playground-build` or CI)
# =============================================================================
/docs/playground/agnostic-ai.wasm
/docs/playground/wasm_exec.js
