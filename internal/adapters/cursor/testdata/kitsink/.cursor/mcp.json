{
  "mcpServers": {
    "disabled-server": {
      "command": "x"
    },
    "http-server": {
      "auth": {
        "CLIENT_ID": "abc123",
        "scopes": [
          "read"
        ]
      },
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx",
      "envFile": "${workspaceFolder}/.env"
    }
  }
}
