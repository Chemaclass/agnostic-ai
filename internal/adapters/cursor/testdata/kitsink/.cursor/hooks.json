{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "echo fmt"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "echo audit",
        "matcher": "rm|dd"
      }
    ],
    "sessionStart": [
      {
        "command": "echo '{\"env\":{\"AGNOSTIC_AI_TARGET\":\"cursor\"}}'"
      }
    ]
  }
}
