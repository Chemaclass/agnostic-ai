{
  "mcpServers": {
    "disabled-server": {
      "command": "x"
    },
    "http-server": {
      "deferTools": "never",
      "filterMapping": "markdown",
      "oauthClientId": "native-client-id",
      "oauthGrantType": "client_credentials",
      "oauthPublicClient": false,
      "oauthScopes": [
        "read"
      ],
      "oidc": true,
      "slowConnectionThresholdMs": 5000,
      "timeout": 45000,
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx",
      "cwd": "${workspaceFolder}",
      "deferTools": "auto",
      "disableToolCache": true,
      "timeout": 45000
    }
  }
}
