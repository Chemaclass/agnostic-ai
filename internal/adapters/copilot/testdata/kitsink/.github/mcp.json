{
  "mcpServers": {
    "disabled-server": {
      "command": "x"
    },
    "http-server": {
      "oauthClientId": "native-client-id",
      "timeout": 45000,
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx",
      "cwd": "${workspaceFolder}",
      "timeout": 45000
    }
  }
}
