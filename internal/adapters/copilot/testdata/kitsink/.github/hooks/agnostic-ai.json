{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Bash",
        "command": "hooks/guard.sh",
        "env": {
          "AGNOSTIC_AI_TARGET": "copilot"
        },
        "timeoutSec": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "Edit",
        "exec": "hooks/format.sh",
        "args": [
          "--fix"
        ],
        "env": {
          "AGNOSTIC_AI_TARGET": "copilot"
        }
      }
    ]
  }
}
