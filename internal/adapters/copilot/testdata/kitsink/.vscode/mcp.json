{
  "servers": {
    "disabled-server": {
      "command": "x",
      "type": "stdio"
    },
    "http-server": {
      "oauth": {
        "clientId": "example-client-id"
      },
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx",
      "cwd": "${workspaceFolder}",
      "dev": {
        "debug": {
          "type": "node"
        },
        "watch": "src/**/*.ts"
      },
      "envFile": "${workspaceFolder}/.env",
      "sandboxEnabled": true,
      "type": "stdio"
    }
  }
}
