{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "gofmt -w",
            "env": {
              "AGNOSTIC_AI_TARGET": "gemini"
            },
            "type": "command"
          }
        ],
        "matcher": "Edit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "echo pre",
            "env": {
              "AGNOSTIC_AI_TARGET": "gemini"
            },
            "type": "command"
          }
        ],
        "matcher": "Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "echo session",
            "env": {
              "AGNOSTIC_AI_TARGET": "gemini"
            },
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "disabled-server": {
      "command": "x"
    },
    "http-server": {
      "description": "Remote MCP over HTTP",
      "excludeTools": [
        "delete_file"
      ],
      "httpUrl": "https://example.test/mcp",
      "includeTools": [
        "read_file"
      ]
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx",
      "timeout": 5000,
      "trust": true
    }
  }
}
