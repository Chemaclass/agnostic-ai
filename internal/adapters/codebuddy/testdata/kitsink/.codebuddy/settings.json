{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "echo 'check changes'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "continueOnBlock": true,
            "prompt": "Check tests pass: $ARGUMENTS",
            "timeout": 30,
            "type": "prompt"
          }
        ]
      }
    ]
  },
  "model": "lite",
  "nativeControl": true,
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(rm *)"
    ]
  },
  "reasoningEffort": "high"
}
