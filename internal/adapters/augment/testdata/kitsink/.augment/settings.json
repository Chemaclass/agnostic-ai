{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "launch-process",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/guard.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "http-server": {
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx"
    }
  }
}
