#!/usr/bin/env bash
# Generated by agnostic-ai. Do not edit this file directly; edit specs under .agnostic-ai/ and run `agnostic-ai sync`.
set -e
export AGNOSTIC_AI_TARGET=cline
aai_err=$(mktemp)
trap 'rm -f "$aai_err"' EXIT
aai_json() { awk 'BEGIN { ORS = "" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, ""); if (NR > 1) printf "\\n"; print }'; }

(
gofmt -w .
) 2>"$aai_err" && aai_status=0 || aai_status=$?
cat "$aai_err" >&2
if [ "$aai_status" -eq 2 ]; then
  aai_msg=$(aai_json <"$aai_err")
  printf 'HOOK_CONTROL\t{"cancel": true, "errorMessage": "%s"}\n' "${aai_msg:-blocked by a hook that exited 2}"
  exit 0
fi
[ "$aai_status" -eq 0 ] || exit "$aai_status"

(
go vet ./...
) 2>"$aai_err" && aai_status=0 || aai_status=$?
cat "$aai_err" >&2
if [ "$aai_status" -eq 2 ]; then
  aai_msg=$(aai_json <"$aai_err")
  printf 'HOOK_CONTROL\t{"cancel": true, "errorMessage": "%s"}\n' "${aai_msg:-blocked by a hook that exited 2}"
  exit 0
fi
[ "$aai_status" -eq 0 ] || exit "$aai_status"
