{
  "permissions": {
    "allow": [
      "Bash(go test:*)"
    ],
    "deny": [
      "Bash(rm:*)"
    ]
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo session"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR\"/'.claude/hooks/agnostic-ai-cloud-install.sh'; [ ! -f \"$f\" ] || sh \"$f\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "gofmt -w"
          }
        ]
      }
    ]
  },
  "env": {
    "AGNOSTIC_AI_TARGET": "claude"
  },
  "disabledMcpjsonServers": [
    "disabled-server"
  ]
}
