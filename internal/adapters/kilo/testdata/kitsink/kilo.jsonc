{
  "mcp": {
    "disabled-server": {
      "command": [
        "x"
      ],
      "type": "local"
    },
    "http-server": {
      "type": "remote",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "type": "local"
    }
  }
}
