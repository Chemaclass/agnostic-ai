{
  "mcpServers": {
    "local": {
      "args": [
        "server"
      ],
      "command": "npx",
      "cwd": "tools",
      "enabled": false
    },
    "remote": {
      "enabled": true,
      "exposure": "direct",
      "headers": {
        "Authorization": "${TOKEN}"
      },
      "toolExposure": {
        "write_*": "hidden",
        "*": "direct"
      },
      "type": "http",
      "url": "https://example.com/mcp"
    }
  }
}
