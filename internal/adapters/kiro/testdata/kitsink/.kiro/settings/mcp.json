{
  "mcpServers": {
    "disabled-server": {
      "command": "x",
      "disabled": true
    },
    "http-server": {
      "oauth": {
        "clientId": "client-abc",
        "mode": "browser",
        "oauthScopes": [
          "files:read"
        ],
        "redirectUri": "http://localhost:7778/oauth/callback"
      },
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "autoApprove": [
        "read_file"
      ],
      "command": "npx",
      "disabledTools": [
        "delete_file"
      ]
    }
  }
}
