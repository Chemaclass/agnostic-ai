{
  "hooks": {
    "PreToolUse": [
      {
        "command": "export AGNOSTIC_AI_TARGET=crush; ./hooks/no-rm-rf.sh",
        "matcher": "^bash$",
        "name": "no-rm-rf",
        "timeout": 10
      },
      {
        "command": "export AGNOSTIC_AI_TARGET=crush; ./hooks/audit-edit.sh",
        "matcher": "^edit$",
        "name": "audit-edit"
      }
    ]
  },
  "mcp": {
    "disabled-server": {
      "channel_enabled": false,
      "command": "x",
      "disabled": true,
      "type": "stdio"
    },
    "http-server": {
      "channel_enabled": true,
      "channel_reply": {
        "group": {
          "target_meta": "room",
          "target_param": "group_id",
          "tool": "send_group"
        },
        "message_param": "text",
        "suppress_tools": [
          "send",
          "reply"
        ],
        "user": {
          "target_meta": "sender_id",
          "target_param": "user_id",
          "tool": "send_user"
        }
      },
      "disabled_tools": [
        "delete_file"
      ],
      "enabled_tools": [
        "read_file"
      ],
      "oauth": true,
      "oauth_callback_port": 8090,
      "oauth_client_id": "client-abc",
      "sessionless": true,
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx",
      "type": "stdio"
    }
  }
}
