{
  "mcp": {
    "disabled-server": {
      "command": "x",
      "type": "stdio"
    },
    "http-server": {
      "oauth": true,
      "oauth_callback_port": 8090,
      "oauth_client_id": "client-abc",
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx",
      "type": "stdio"
    }
  }
}
