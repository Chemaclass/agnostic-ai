{
  "mcpServers": {
    "docs": {
      "bearerTokenEnvVar": "DOCS_TOKEN",
      "enabled": false,
      "enabledTools": [],
      "transport": "sse",
      "url": "https://example.com/mcp"
    },
    "local": {
      "args": [
        "server.js"
      ],
      "command": "node",
      "executor": "local",
      "runtime_id": "workspace",
      "transport": "stdio"
    }
  }
}
