{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "export AGNOSTIC_AI_TARGET=codex; echo session",
            "commandWindows": "echo session"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "export AGNOSTIC_AI_TARGET=codex; echo pre",
            "commandWindows": "echo pre",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "export AGNOSTIC_AI_TARGET=codex; gofmt -w",
            "commandWindows": "gofmt -w",
            "additionalContextLimit": 2000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "scanner",
            "tool": "scan_patch",
            "input": {
              "patch": "${tool_input.command}"
            }
          }
        ]
      }
    ]
  }
}
