{
  "mcpServers": {
    "disabled-server": {
      "command": "x",
      "disabled": true
    },
    "http-server": {
      "alwaysAllow": [
        "read_file"
      ],
      "description": "Remote MCP over HTTP",
      "excludeTools": [
        "delete_file"
      ],
      "includeTools": [
        "read_file"
      ],
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx",
      "cwd": "/srv/project",
      "timeout": 4500,
      "trust": true
    }
  }
}
