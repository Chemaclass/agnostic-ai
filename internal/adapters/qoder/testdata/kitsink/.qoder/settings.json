{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "scripts/check.py",
              "--strict"
            ]
          }
        ]
      }
    ],
    "CustomThing": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo custom"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "disabled-server": {
      "command": "x",
      "disabled": true
    },
    "http-server": {
      "alwaysAllow": [
        "read_file"
      ],
      "description": "Remote MCP over HTTP",
      "excludeTools": [
        "delete_file"
      ],
      "includeTools": [
        "read_file"
      ],
      "type": "http",
      "url": "https://example.test/mcp"
    },
    "stdio-server": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "command": "npx",
      "cwd": "/srv/project",
      "timeout": 4500,
      "trust": true
    }
  }
}
