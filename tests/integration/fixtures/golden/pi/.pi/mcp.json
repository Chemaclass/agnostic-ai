{
  "mcpServers": {
    "pi-local": {
      "args": [
        "--stdio"
      ],
      "command": "native-server",
      "cwd": "tools",
      "enabled": false,
      "exposure": "direct"
    },
    "pi-remote": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ${PI_TOKEN}"
      },
      "timeout": 45,
      "type": "http",
      "url": "https://example.test/mcp"
    }
  }
}
