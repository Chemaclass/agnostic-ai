{
  "$schema": "https://opencode.ai/config.json",
  "model": "example-model",
  "permission": {
    "bash": {
      "go test *": "allow",
      "rm *": "deny",
      "rm -rf /": "deny"
    },
    "edit": {
      ".env*": "ask"
    },
    "github_create_issue": "deny",
    "read": {
      "**": "allow"
    },
    "websearch": "deny"
  }
}
