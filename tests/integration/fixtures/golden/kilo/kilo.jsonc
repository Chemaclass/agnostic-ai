{
  "model": "example-model",
  "permission": {
    "bash": {
      "go test *": "allow",
      "rm *": "deny",
      "rm -rf /": "deny"
    },
    "edit": {
      "*": "allow",
      ".env*": "ask",
      ".env": "deny"
    },
    "github_create_issue": {
      "*": "deny"
    },
    "read": {
      "**": "allow"
    },
    "websearch": {
      "*": "deny"
    }
  }
}
