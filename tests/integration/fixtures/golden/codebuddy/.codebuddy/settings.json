{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "echo edited",
            "type": "command"
          }
        ],
        "matcher": "Edit"
      }
    ]
  },
  "model": "example-model",
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(go test:*)"
    ],
    "ask": [
      "Write(.env*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf /)",
      "WebSearch",
      "mcp__github__create_issue"
    ]
  }
}
