#!/usr/bin/env bash
# Generated by agnostic-ai. Do not edit this file directly; edit specs under .agnostic-ai/ and run `agnostic-ai sync`.
set -e
export AGNOSTIC_AI_TARGET=cline
aai_err=$(mktemp)
trap 'rm -f "$aai_err"' EXIT
aai_json() { LC_ALL=C tr -d '\000-\010\013-\037\177' | LC_ALL=C awk 'BEGIN { ORS = "" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/{/, "\\u007b"); gsub(/}/, "\\u007d"); if (NR > 1) printf "\\n"; print }'; }

set +e
(
set -e
sh -c 'd=$(pwd); until [ -x "$d/node_modules/.bin/agnostic-ai" ] || [ -f "$d/agnostic-ai.yaml" ] || [ -f "$d/agnostic.config.yaml" ] || [ "$d" = "$(dirname "$d")" ]; do d=$(dirname "$d"); done; bin="$d/node_modules/.bin/agnostic-ai"; [ -x "$bin" ] || bin=agnostic-ai; command -v "$bin" >/dev/null || exit 0; AGNOSTIC_AI_NO_UPDATE_CHECK=1 "$bin" project --help >/dev/null 2>&1 || { echo "agnostic-ai: this version has no project command; upgrade to 0.83.0 or newer" >&2; exit 1; }; exec "$bin" project -- hook memory --target cline'
) 2>"$aai_err"
aai_status=$?
set -e
cat "$aai_err" >&2
if [ "$aai_status" -eq 2 ]; then
  aai_msg=$(aai_json <"$aai_err") || aai_msg=
  printf 'HOOK_CONTROL\t{"cancel": true, "errorMessage": "%s"}\n' "${aai_msg:-blocked by a hook that exited 2}"
  exit 0
fi
[ "$aai_status" -eq 0 ] || exit "$aai_status"
