{
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(go test:*)"
    ],
    "ask": [
      "Write(.env*)",
      "Edit(/.github/**)",
      "Edit(/composer.lock)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf /)",
      "WebSearch",
      "mcp__github__create_issue",
      "AuthorOnly"
    ]
  },
  "model": "example-model",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/shared-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo edited"
          }
        ]
      }
    ]
  },
  "env": {
    "AGNOSTIC_AI_TARGET": "claude"
  }
}
