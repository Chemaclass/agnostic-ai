{
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(go test:*)"
    ],
    "ask": [
      "Write(.env*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf /)"
    ]
  },
  "model": "example-model",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo edited"
          }
        ]
      }
    ]
  }
}
