{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".qoder/hooks/shared-guard.sh",
            "env": {
              "AGNOSTIC_AI_TARGET": "qoder"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo edited",
            "env": {
              "AGNOSTIC_AI_TARGET": "qoder"
            }
          }
        ]
      }
    ]
  },
  "model": {
    "name": "example-model"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(go test:*)"
    ],
    "ask": [
      "Write(.env*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf /)",
      "WebSearch",
      "mcp__github__create_issue"
    ]
  }
}
