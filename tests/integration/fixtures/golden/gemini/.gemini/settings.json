{
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": ".gemini/hooks/shared-guard.sh",
            "env": {
              "AGNOSTIC_AI_TARGET": "gemini"
            },
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "sh .gemini/hooks/agnostic-ai-protect.sh",
            "env": {
              "AGNOSTIC_AI_TARGET": "gemini"
            },
            "type": "command"
          }
        ],
        "matcher": "^(write_file|replace)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "echo edited",
            "description": "A sample hook for golden snapshot tests.",
            "env": {
              "AGNOSTIC_AI_TARGET": "gemini"
            },
            "type": "command"
          }
        ],
        "matcher": "Edit"
      }
    ]
  },
  "mcpServers": {
    "gemini-oauth": {
      "httpUrl": "https://docs.example/mcp",
      "oauth": {
        "allowPrivateNetwork": true,
        "authorizationResponseIssParameterSupported": false,
        "enabled": true
      }
    }
  },
  "model": {
    "name": "example-model"
  }
}
