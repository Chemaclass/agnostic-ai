{
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": ".gemini/hooks/shared-guard.sh",
            "env": {
              "AGNOSTIC_AI_TARGET": "gemini"
            },
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "echo edited",
            "description": "A sample hook for golden snapshot tests.",
            "env": {
              "AGNOSTIC_AI_TARGET": "gemini"
            },
            "type": "command"
          }
        ],
        "matcher": "Edit"
      }
    ]
  },
  "model": {
    "name": "example-model"
  }
}
